<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QBank.App.Controls.RegionPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Black">
        <Image x:Name="ShotImage" Stretch="Fill" />

        <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <Rectangle x:Name="SelectionRect" Visibility="Collapsed"
                       Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                       Fill="#33FFFFFF" />
        </Canvas>

        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0"
                Padding="14,8" CornerRadius="6" Background="#CC000000">
            <StackPanel Spacing="2">
                <TextBlock x:Name="HintText" Text="按住鼠标左键拖一个框，松手就开始识别" Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock Text="按 Esc 取消" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="SizeText" Foreground="White" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   Margin="0,0,16,16" FontSize="12" />
    </Grid>
</Window>