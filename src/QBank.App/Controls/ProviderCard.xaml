<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QBank.App.Controls.ProviderCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardBorder}" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <StackPanel Spacing="10">

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="NameBox" Grid.Column="0" Header="名称" PlaceholderText="例如 DeepSeek" />
                <ComboBox x:Name="KindCombo" Grid.Column="1" Header="类型" Width="170" VerticalAlignment="Bottom"
                          SelectionChanged="OnKindChanged">
                    <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                    <ComboBoxItem Content="硅基流动" Tag="siliconflow" />
                    <ComboBoxItem Content="阿里云百炼" Tag="bailian" />
                    <ComboBoxItem Content="OpenAI" Tag="openai" />
                    <ComboBoxItem Content="Ollama（本地）" Tag="ollama" />
                    <ComboBoxItem Content="自定义（OpenAI 兼容）" Tag="custom" />
                </ComboBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <CheckBox x:Name="EnabledBox" Content="启用" MinWidth="0" />
                    <Button Content="删除" Click="OnDelete" />
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BaseUrlBox" Grid.Column="0" Header="接口地址 (BaseUrl)"
                         PlaceholderText="https://api.deepseek.com/v1" />
                <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" Header="API Key"
                             PlaceholderText="sk-..." PasswordRevealMode="Peek" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ModelCombo" Grid.Column="0" Header="模型" IsEditable="True"
                          PlaceholderText="点右侧「获取模型」拉取列表，也可以直接手填" />
                <Button x:Name="FetchModelsButton" Grid.Column="1" Content="获取模型"
                        VerticalAlignment="Bottom" Click="OnFetchModels" />
                <Button x:Name="OllamaPullButton" Grid.Column="2" Content="本机模型"
                        VerticalAlignment="Bottom" Click="OnFetchModels" Visibility="Collapsed" />
            </Grid>

            <TextBlock x:Name="ModelStatus" Style="{StaticResource Subtle}" TextWrapping="Wrap" />

            <Expander Header="高级参数" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Padding="0,8,0,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="TemperatureBox" Grid.Column="0" Header="温度 Temperature"
                                   Minimum="0" Maximum="2" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="MaxTokensBox" Grid.Column="1" Header="最大输出 tokens"
                                   Minimum="64" Maximum="32768" SmallChange="256" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="TimeoutBox" Grid.Column="2" Header="超时（秒）"
                                   Minimum="5" Maximum="600" SpinButtonPlacementMode="Compact" />
                    </Grid>

                    <TextBox x:Name="ExtraParamsBox" Header="额外请求体参数（JSON，可选）"
                             PlaceholderText="{}{&quot;enable_thinking&quot;: false}" />

                    <TextBox x:Name="SystemPromptBox" Header="自定义提示词（留空用内置）"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="70" />

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox x:Name="JsonModeBox" Content="强制 JSON 输出（response_format）" />
                        <CheckBox x:Name="VisionBox" Content="支持图片输入（可用于识图）" />
                        <NumberBox x:Name="PriorityBox" Header="优先级" Minimum="0" Maximum="999"
                                   SpinButtonPlacementMode="Compact" Width="120" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="TestButton" Content="测试连接" Click="OnTest" />
                <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="TestResult" Style="{StaticResource Subtle}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
