<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QBank.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="20,12,20,20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：输入区 -->
        <Grid Grid.Column="0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">

                    <TextBlock Text="搜题" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="粘贴题干后按 Ctrl+Enter 直接搜索" Style="{StaticResource Subtle}" />

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="10">

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="TypeCombo" Grid.Column="0" Header="题型" Width="140" SelectedIndex="0">
                                    <ComboBoxItem Content="自动判断" Tag="unknown" />
                                    <ComboBoxItem Content="单选题" Tag="single" />
                                    <ComboBoxItem Content="多选题" Tag="multiple" />
                                    <ComboBoxItem Content="判断题" Tag="judgement" />
                                    <ComboBoxItem Content="填空题" Tag="completion" />
                                </ComboBox>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal"
                                            Spacing="6" HorizontalAlignment="Right">
                                    <Button x:Name="OcrShotButton" Content="截图识题" Click="OnOcrScreenshot"
                                            ToolTipService.ToolTip="截取整个屏幕并识别题目" />
                                    <Button x:Name="OcrFileButton" Content="选图片" Click="OnOcrFile"
                                            ToolTipService.ToolTip="从文件中选择题目截图" />
                                </StackPanel>
                            </Grid>

                            <TextBox x:Name="TitleBox"
                                     Header="题干"
                                     PlaceholderText="粘贴题目，例如：中国的首都是哪座城市?"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="92"
                                     KeyDown="OnTitleKeyDown" />

                            <TextBox x:Name="OptionsBox"
                                     Header="选项（可选，一行一个）"
                                     PlaceholderText="A. 上海&#x0a;B. 北京&#x0a;C. 广州"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="96" />

                            <TextBlock Text="题目来源" Style="{StaticResource SectionTitle}" Margin="0,4,0,0" />
                            <Grid x:Name="SourcePanel" ColumnSpacing="10" RowSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                            </Grid>

                            <ProgressBar x:Name="SearchProgress" IsIndeterminate="True" Visibility="Collapsed" />

                            <TextBlock x:Name="OcrStatusText" Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 操作条固定在左栏底部，不会被内容挤出去 -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SearchButton" Content="开始搜题" Style="{StaticResource AccentButtonStyle}"
                            MinWidth="120" Click="OnSearch" />
                    <Button x:Name="CancelButton" Content="取消" Click="OnCancel" IsEnabled="False" />
                    <Button x:Name="ClearButton" Content="清空" Click="OnClear" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 右：结果区 -->
        <Grid Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                <TextBlock Text="搜索结果" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                <TextBlock x:Name="ResultMeta" Style="{StaticResource Subtle}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="520" />
            </StackPanel>

            <!-- 最佳答案卡片 -->
            <Border x:Name="BestCard" Grid.Row="1" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE930;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="最佳答案" Style="{StaticResource SectionTitle}" Margin="0" />
                        <TextBlock x:Name="BestSource" Style="{StaticResource Subtle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="BestAnswerText" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="复制答案" Click="OnCopyBest" />
                        <Button Content="存入本地题库" Click="OnSaveBest" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                    <ItemsControl x:Name="ResultList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4" Padding="8,2,8,2">
                                                <TextBlock Text="{Binding Answer}" Foreground="White"
                                                           FontWeight="SemiBold" FontSize="15" />
                                            </Border>
                                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Subtle}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Subtle}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding QuestionText}" TextWrapping="Wrap" FontSize="13" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyHint" Text="还没有结果。粘贴题干后点「开始搜题」。"
                               Style="{StaticResource Subtle}" Margin="0,24,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
