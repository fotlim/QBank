<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QBank.App.Pages.LanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="20,12,20,24" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

            <StackPanel Spacing="2">
                <TextBlock Text="局域网共享" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="LanStatusText" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 本机共享 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="12">
                    <TextBlock Text="本机共享设置" Style="{StaticResource SectionTitle}" Margin="0" />

                    <StackPanel Spacing="6">
                        <CheckBox x:Name="EnableBox" Content="允许其它设备查询我的题库" />
                        <CheckBox x:Name="DiscoveryBox" Content="响应局域网自动发现（UDP 广播）" />
                        <CheckBox x:Name="AllowLanBox" Content="对局域网开放（关闭则只允许本机 127.0.0.1 访问）" />
                        <CheckBox x:Name="AllowWriteBox" Content="允许远端写入（对方可往我的题库加题，默认关闭）" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="PortBox" Grid.Column="0" Header="服务端口"
                                   Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="DiscoveryPortBox" Grid.Column="1" Header="发现端口"
                                   Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="MaxResultsBox" Grid.Column="2" Header="单次最多返回条数"
                                   Minimum="1" Maximum="50" SpinButtonPlacementMode="Compact" />
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ServerNameBox" Grid.Column="0" Header="本机显示名"
                                 PlaceholderText="留空用计算机名" />
                        <PasswordBox x:Name="TokenBox" Grid.Column="1" Header="访问口令（可选）"
                                     PlaceholderText="留空则局域网内任何人可查" PasswordRevealMode="Peek" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="保存并应用" Style="{StaticResource AccentButtonStyle}" Click="OnSaveServer" />
                        <Button Content="重新加载" Click="OnReload" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 发现与节点 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="局域网节点" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="DiscoverButton" Content="搜索局域网节点" Click="OnDiscover" />
                            <Button Content="手动添加" Click="OnAddPeerManually" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="DiscoverHint" Style="{StaticResource Subtle}" TextWrapping="Wrap"
                               Text="同一局域网内的其它电脑开着「题库工坊」且启用了共享时，能在这里被发现。" />

                    <StackPanel x:Name="PeerList" Spacing="8" />
                </StackPanel>
            </Border>

            <!-- 共享与同步 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="12">
                    <TextBlock Text="题库同步" Style="{StaticResource SectionTitle}" Margin="0" />
                    <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                               Text="把你的题目推送到其它节点（对方需要允许远端写入），或者把别人的题库拉过来合并。拉取默认走增量：只取对方上次同步之后改动过的题目。" />
                    <CheckBox x:Name="IncrementalBox" Content="只拉上次同步之后改动的题目（增量）" IsChecked="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="推送本地题目到所有节点" Click="OnPushAll" />
                        <Button Content="从所有节点拉取题库" Click="OnPullAll" />
                        <Button Content="忘了同步记录（下次全量）" Click="OnForgetSync" />
                    </StackPanel>
                    <TextBlock x:Name="SyncStatus" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
