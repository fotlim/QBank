<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 用 Windows 目标框架：Windows.Media.Ocr（系统内置 OCR）与 WinRT 图片解码都依赖它 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>QBank.Core</RootNamespace>
    <AssemblyName>QBank.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 纯托管 JS 解释器：用于执行 OCS 题库配置里的 handler / data 字段解析器 -->
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <!-- 截图（ScreenCapture）与图片缩放 -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

</Project>
